# For complex business rules, break down the logic:

# Calculate lien loss with special handling:
# 1. If sale price is null, exclude from calculation
# 2. If outstanding balance < 0, treat as 0 (data error)
# 3. If sale price > balance, lien loss = 0 (no loss)
# 4. Otherwise, lien loss = balance - sale price

def calculate_lien_loss(row):
    """
    Calculate lien loss with business rule handling.
    
    Parameters:
    - row: DataFrame row with 'outstanding_balance' and 'sale_price'
    
    Returns:
    - float: Calculated lien loss (0 or positive value)
    """
    # Handle null sale price
    if pd.isna(row['sale_price']):
        return None
    
    # Handle negative balance (data quality issue)
    balance = max(0, row['outstanding_balance'])
    
    # Calculate lien loss
    lien_loss = max(0, balance - row['sale_price'])
    
    return lien_loss

# Apply to dataframe
df['lien_loss'] = df.apply(calculate_lien_loss, axis=1)
```

